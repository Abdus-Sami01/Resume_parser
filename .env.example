# --- Extraction pipeline ---
# "heuristic" (default, offline, no key needed) or "llm" (uses Instructor + OpenAI/Groq-compatible client)
EXTRACTION_BACKEND=heuristic
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# --- Vector search pipeline ---
# "memory" (default, in-process cosine search) or "qdrant"
VECTOR_STORE_BACKEND=memory
# Set to ":memory:" to run the Qdrant backend embedded, without a server
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=resumes

# --- Embeddings ---
# "hash" (default, deterministic offline embedder) or "openai"
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=256

# --- Reranking ---
# "lexical" (default, offline token-overlap reranker) or "cross_encoder"
RERANKER_BACKEND=lexical
RERANKER_MODEL=BAAI/bge-reranker-large

# --- Scoring weights (must sum to 1.0) ---
WEIGHT_EXPERIENCE=0.5
WEIGHT_SKILLS=0.4
WEIGHT_EDUCATION=0.1

# --- Record storage ---
# "memory" is in-process and lost on restart; "sqlite" persists to a file
STORE_BACKEND=memory
SQLITE_PATH=data/resume_parser.db
# Re-embeds stored resumes at boot when the index is empty but records exist
REINDEX_ON_STARTUP=true

# --- Skill taxonomy ---
# Runtime skill additions land here, leaving the bundled skills.json untouched
CUSTOM_SKILLS_PATH=data/custom_skills.json

# --- Uploads ---
MAX_UPLOAD_BYTES=10485760

# --- Retrieval ---
RETRIEVAL_TOP_K=50
RERANK_TOP_N=10

# --- Background tasks ---
# "eager" runs parse jobs inline (no broker needed); "celery" dispatches to a worker
TASK_BACKEND=eager
REDIS_URL=redis://localhost:6379/0
